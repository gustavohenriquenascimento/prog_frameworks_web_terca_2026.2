// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum StatusLocacao {
  ATIVA
  FINALIZADA
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senhaHash String
  createdAt DateTime  @default(now())
  locacoes  Locacao[]
}

model Veiculo {
  id          Int       @id @default(autoincrement())
  marca       String
  modelo      String
  placa       String    @unique
  ano         Int
  valorDiaria Decimal   @db.Decimal(10, 2)
  disponivel  Boolean   @default(true)
  locacoes    Locacao[]
}

model Locacao {
  id                    Int           @id @default(autoincrement())
  usuarioId             Int
  veiculoId             Int
  dataInicio            DateTime
  dataPrevistaDevolucao DateTime
  dataDevolucao         DateTime?
  valorTotal            Decimal       @db.Decimal(10, 2)
  status                StatusLocacao @default(ATIVA)
  createdAt             DateTime      @default(now())
  usuario               Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  veiculo               Veiculo       @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([veiculoId, status])
}
